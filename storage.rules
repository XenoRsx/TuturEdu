rules_version = '2';

// Firebase Storage rules for chat attachments.
// Mirrors firestore.rules' chat access model: only a chat's participants
// may read/write its attachments. Storage rules can check size and
// content-type, but CANNOT read a file's magic number - that validation
// happens client-side in lib/utils/file_validator.dart before upload (see
// BLUEPRINT.md section 8.5 for the client-side vs server-side trade-off).
//
// Note: deliberately NOT checking request.resource.size here. Confirmed by
// testing that it makes this rule evaluate to false for every write from
// the Flutter Web app (likely a resumable-upload quirk where size isn't
// reliably available at the point Rules run) - the exact same request
// succeeds once the size check is removed. The 10MB limit is already
// enforced client-side in file_validator.dart before upload starts, so
// this isn't a real gap for the app itself, just for anyone bypassing the
// app entirely - acceptable trade-off for this project.
service firebase.storage {
  match /b/{bucket}/o {
    match /chats/{chatId}/attachments/{fileName} {
      // Read: originally cross-checked firestore.get(...).data.participants
      // here too, same as write used to. Confirmed by testing (2026-09-07)
      // that this firestore.get() cross-service read is NOT reliable even
      // for a plain GET - specifically right after a resumable upload
      // session closes, getDownloadURL() calling into this rule can 403
      // even for a genuine participant, and it's intermittent (retrying
      // client-side helped sometimes but not reliably). Relaxed to any
      // authenticated user for the same reason write was: the path segment
      // is a random Firestore-generated message ID (not guessable), and
      // getDownloadURL()'s whole job is to hand back a URL carrying a
      // download token that becomes forwardable/cacheable by anyone who
      // receives it regardless of this rule - so this rule was mainly
      // stopping outsiders from minting that token themselves, not
      // protecting content that's already exposed once shared. Acceptable
      // trade-off for this project's scope, same as the write rule below.
      allow read: if request.auth != null;

      // Write: confirmed by testing that Web's resumable-upload protocol
      // evaluates this rule during the session-start request, where the
      // firestore.get() cross-service read does not reliably resolve -
      // every Web upload gets denied with the participants check in place,
      // and the exact same request succeeds once it's removed (same
      // category of quirk as the request.resource.size note above).
      // Relaxed to any authenticated user. This is mitigated in practice:
      // a message pointing at the uploaded file can only be created by an
      // actual chat participant (firestore.rules' messages/{messageId}
      // create rule - a plain Firestore write, unaffected by this Storage-
      // side quirk), so a non-participant writing a file here can't make
      // it appear as a real message to anyone.
      allow write: if request.auth != null;

      allow delete: if false;
    }
  }
}
