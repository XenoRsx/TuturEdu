rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check sama ada user semasa ialah Admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Collection: users
    // - Sesiapa yang dah login boleh READ (perlu untuk teacher list & role check)
    // - User boleh EDIT profile dia sendiri, ATAU Admin boleh edit/delete mana-mana user
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                    (request.auth.uid == userId || isAdmin());
    }

    // Collection: subjectCatalog
    // - Sesiapa yang dah login boleh READ (perlu untuk teacher/student pilih subjek)
    // - Hanya Admin boleh tambah/edit/padam
    match /subjectCatalog/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Collection: chats
    // - Hanya participant (student/teacher yang terlibat) boleh read chat tu
    // - Update dibenarkan untuk mana-mana participant, KECUALI perubahan pada
    //   senarai `participants` (ahli group) - itu hanya untuk groupAdmin, atau
    //   member biasa yang buang diri sendiri sahaja ("Leave Group")
    // - Delete tidak dibenarkan langsung (tiada UI padam chat)
    match /chats/{chatId} {
      allow read: if request.auth != null &&
                   request.auth.uid in resource.data.participants;

      allow update: if request.auth != null &&
                     request.auth.uid in resource.data.participants &&
                     (
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']) ||
                       (resource.data.isGroup == true && resource.data.groupAdmin == request.auth.uid) ||
                       (resource.data.isGroup == true &&
                        request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid]))
                     );

      allow delete: if false;

      // Untuk create chat baru (document belum wujud lagi)
      allow create: if request.auth != null &&
                     request.auth.uid in request.resource.data.participants;

      // Sub-collection: messages
      match /messages/{messageId} {
        allow read: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                       request.resource.data.senderId == request.auth.uid;

        // Elak sesiapa edit/delete mesej lepas dihantar
        allow update, delete: if false;
      }

      // Sub-collection: scheduledReplies (Overtime Mode - "Schedule Reply")
      // Hanya participant boleh baca. Hanya pemilik (senderId) boleh cipta/
      // kemaskini (contoh: tukar status jadi "sent", atau cancel/delete).
      match /scheduledReplies/{replyId} {
        allow read: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                       request.resource.data.senderId == request.auth.uid;

        allow update, delete: if request.auth != null &&
                       resource.data.senderId == request.auth.uid;
      }
    }

    // Collection: quizzes (Interactive Quiz - Live Session, rujuk BLUEPRINT.md Seksyen 9)
    // - Sesiapa yang login boleh baca (perlu untuk student main quiz)
    // - Hanya pencipta (Teacher) boleh cipta/edit/padam quiz dia sendiri
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null &&
                              request.auth.uid == resource.data.createdBy;

      // Sub-collection: questions
      // Nota 1: correctIndex boleh dibaca oleh sesiapa yang login - perlu
      // sebab markah dikira client-side semasa main (tiada Cloud Function
      // untuk sembunyikan jawapan betul sehingga selepas dijawab). Had FYP
      // semasa, diterima sebagai trade-off - rujuk BLUEPRINT.md 8.5 untuk
      // nota serupa pasal client-side vs server-side validation.
      // Nota 2: `createdBy` di-denormalize terus pada setiap question doc
      // (bukan get() ke parent quiz) sebab quiz + questions dicipta dalam
      // SATU batch write - get() ke parent akan gagal masa tu sebab
      // dokumen parent belum "wujud" lagi pada waktu rules dinilai untuk
      // write lain dalam batch yang sama.
      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.createdBy;
        allow update, delete: if request.auth != null &&
                                request.auth.uid == resource.data.createdBy;
      }
    }

    // Collection: quizSessions (Live Session sahaja)
    // - Sesiapa yang login boleh baca (student perlu tengok status/currentQuestionIndex)
    // - Hanya host (teacher yang start sesi) boleh cipta/kemaskini sesi dia sendiri
    match /quizSessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null &&
                     request.auth.uid == resource.data.hostUid;
      allow delete: if false;

      // Sub-collection: participants
      // - Student cipta/kemaskini dokumen DIA SENDIRI sahaja (nama, score,
      //   jawapan) - had FYP: score dikira & ditulis client-side, tiada
      //   pengesahan server (sama trade-off macam questions.correctIndex di atas)
      match /participants/{studentUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null &&
                                request.auth.uid == studentUid;
        allow delete: if false;
      }
    }
  }
}
