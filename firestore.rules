rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check sama ada user semasa ialah Admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Helper: check sama ada user semasa (biasanya Teacher) mengajar `subject`
    // tu - dipakai untuk rules `performance` & `attendance`
    function teachesSubject(subject) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             subject in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subjects;
    }

    // Helper: check sama ada user semasa ialah Teacher
    function isTeacher() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Teacher';
    }

    // Collection: users
    // - Sesiapa yang dah login boleh READ (perlu untuk teacher list & role check)
    // - User boleh EDIT profile dia sendiri, ATAU Admin boleh edit/delete mana-mana user
    // - Teacher turut boleh kemaskini field `subjects` SAHAJA pada dokumen
    //   seorang Student (bukan field lain, bukan role selain Student) -
    //   perlu untuk user_profile_screen.dart's "Edit Subjects" bila Teacher
    //   tengok profile student (assign subjek terus, bukan setakat Admin).
    // - Role escalation (BLUEPRINT.md 5.27): user BUKAN Admin hanya boleh
    //   cipta dokumen sendiri sebagai Student/Parent (bukan Teacher/Admin),
    //   dan TAK boleh ubah `role`/`parentUid`/`childUids` sendiri selepas itu.
    //   Hanya Admin tetapkan role Teacher/Admin & pautan parent-anak. Tanpa
    //   ni, sesiapa boleh tukar role sendiri ke "Admin" terus melalui API.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() ||
                     (request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.data.role in ['Student', 'Parent'] &&
                      !('parentUid' in request.resource.data) &&
                      !('childUids' in request.resource.data));
      allow update: if isAdmin() ||
                     (request.auth != null &&
                      request.auth.uid == userId &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'parentUid', 'childUids'])) ||
                     (isTeacher() &&
                      resource.data.role == 'Student' &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subjects']));
      allow delete: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());
    }

    // Collection: subjectCatalog
    // - Sesiapa yang dah login boleh READ (perlu untuk teacher/student pilih subjek)
    // - Hanya Admin boleh tambah/edit/padam
    match /subjectCatalog/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Collection: chats
    // - Hanya participant (student/teacher yang terlibat) boleh read chat tu,
    //   ATAU Admin (perlu untuk count() aggregation dalam admin_reports_screen.dart)
    // - Update dibenarkan untuk mana-mana participant, KECUALI perubahan pada
    //   senarai `participants` (ahli group) - itu hanya untuk groupAdmin, atau
    //   member biasa yang buang diri sendiri sahaja ("Leave Group")
    // - Delete tidak dibenarkan langsung (tiada UI padam chat)
    match /chats/{chatId} {
      allow read: if request.auth != null &&
                   (request.auth.uid in resource.data.participants || isAdmin());

      allow update: if request.auth != null &&
                     request.auth.uid in resource.data.participants &&
                     (
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']) ||
                       (resource.data.isGroup == true && resource.data.groupAdmin == request.auth.uid) ||
                       (resource.data.isGroup == true &&
                        request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid]))
                     );

      // "Delete for Everyone" (rujuk BLUEPRINT.md - Delete Chat): padam
      // terus dokumen chat (lepas client dah padam semua messages dalam
      // batch berasingan - rujuk allow delete kat messages di bawah). Mana-
      // mana participant boleh buat untuk chat 1:1, tapi untuk GROUP hanya
      // groupAdmin sahaja (sama restriction macam participant-removal rule
      // kat atas). "Delete for Me" (hide chat dari list sendiri sahaja,
      // deletedFor.{uid} timestamp) TAK perlukan rule baru - update rule di
      // atas dah benarkan participant tulis mana-mana field selain
      // `participants` dengan bebas, sama macam lastRead/unreadCount.
      allow delete: if request.auth != null &&
                     request.auth.uid in resource.data.participants &&
                     (resource.data.isGroup != true ||
                      resource.data.groupAdmin == request.auth.uid);

      // Untuk create chat baru (document belum wujud lagi)
      allow create: if request.auth != null &&
                     request.auth.uid in request.resource.data.participants;

      // Sub-collection: messages
      match /messages/{messageId} {
        allow read: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                       request.resource.data.senderId == request.auth.uid;

        // Soft-delete sahaja (rujuk BLUEPRINT.md 5.16): sender boleh padam
        // mesej DIA SENDIRI dalam masa 15 minit selepas hantar, ATAU Admin
        // boleh padam mana-mana mesej bila-bila (moderation). Update
        // dihadkan KETAT ke field `deleted`/`deletedAt` sahaja - tiada
        // laluan lain untuk ubah kandungan mesej lepas dihantar.
        allow update: if request.auth != null &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt']) &&
                       request.resource.data.deleted == true &&
                       (
                         (resource.data.senderId == request.auth.uid &&
                          request.time < resource.data.timestamp + duration.value(15, 'm')) ||
                         isAdmin()
                       );

        // Deliberate narrow carve-out from "messages are soft-delete only"
        // above: a participant CAN hard-delete a message doc, but this is
        // only ever exercised by "Delete for Everyone" wiping an ENTIRE
        // chat's messages at once (chat_list_screen.dart) - there is no UI
        // path to selectively hard-delete one message while keeping others,
        // so the audit-trail guarantee for a chat that's still alive and
        // merely soft-deleting individual messages is unaffected.
        allow delete: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      // Sub-collection: scheduledReplies (Overtime Mode - "Schedule Reply")
      // Hanya participant boleh baca. Hanya pemilik (senderId) boleh cipta/
      // kemaskini (contoh: tukar status jadi "sent", atau cancel/delete).
      match /scheduledReplies/{replyId} {
        allow read: if request.auth != null &&
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                       request.resource.data.senderId == request.auth.uid;

        allow update, delete: if request.auth != null &&
                       resource.data.senderId == request.auth.uid;
      }
    }

    // Collection: quizzes (Interactive Quiz - Live Session, rujuk BLUEPRINT.md Seksyen 9)
    // - Sesiapa yang login boleh baca (perlu untuk student main quiz)
    // - Hanya pencipta (Teacher) boleh cipta/edit/padam quiz dia sendiri
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null &&
                              request.auth.uid == resource.data.createdBy;

      // Sub-collection: questions
      // Nota 1: jawapan betul (correctIndex) TIDAK lagi disimpan di sini -
      // dipindah ke answerKeys di bawah (rujuk BLUEPRINT.md 9.8). Dulu
      // sesiapa yang login boleh baca correctIndex terus dari question doc
      // (markah dikira client-side). Create/update kini MENOLAK sebarang
      // write yang bawa field correctIndex, supaya jawapan tak bocor balik
      // ke sini secara tak sengaja.
      // Nota 2: `createdBy` di-denormalize terus pada setiap question doc
      // (bukan get() ke parent quiz) sebab quiz + questions dicipta dalam
      // SATU batch write - get() ke parent akan gagal masa tu sebab
      // dokumen parent belum "wujud" lagi pada waktu rules dinilai untuk
      // write lain dalam batch yang sama.
      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.createdBy &&
                       !('correctIndex' in request.resource.data);
        allow update: if request.auth != null &&
                       request.auth.uid == resource.data.createdBy &&
                       !('correctIndex' in request.resource.data);
        allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.createdBy;
      }

      // Sub-collection: answerKeys (doc ID = questionId) - jawapan betul,
      // HANYA teacher pencipta (atau Admin) boleh baca. Student tak boleh
      // baca langsung - markah dikira oleh Cloud Function submitQuizAttempt
      // / submitLiveAnswer (Admin SDK, bypass rules). `createdBy`
      // di-denormalize atas sebab yang sama macam questions (Nota 2).
      match /answerKeys/{questionId} {
        allow read: if request.auth != null &&
                     (request.auth.uid == resource.data.createdBy || isAdmin());
        allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.createdBy;
        allow update, delete: if request.auth != null &&
                                request.auth.uid == resource.data.createdBy;
      }
    }

    // Collection: quizSessions (Live Session sahaja)
    // - Sesiapa yang login boleh baca (student perlu tengok status/currentQuestionIndex)
    // - Hanya host (teacher yang start sesi) boleh cipta/kemaskini sesi dia sendiri
    match /quizSessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null &&
                     request.auth.uid == resource.data.hostUid;
      allow delete: if false;

      // Sub-collection: participants
      // - Student cipta dokumen DIA SENDIRI sahaja masa join, dengan score 0
      //   dan answers kosong. Jawapan + markah TIDAK boleh ditulis dari
      //   client lagi - hanya Cloud Function submitLiveAnswer (Admin SDK)
      //   yang tulis answers/score, selepas semak jawapan dengan answerKeys.
      // - Update dari client hanya dibenarkan untuk join semula (set() ke
      //   dokumen sedia ada) SEBELUM menjawab apa-apa - score kekal 0,
      //   answers kekal kosong.
      match /participants/{studentUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
                       request.auth.uid == studentUid &&
                       request.resource.data.score == 0 &&
                       request.resource.data.answers.size() == 0;
        allow update: if request.auth != null &&
                       request.auth.uid == studentUid &&
                       resource.data.answers.size() == 0 &&
                       request.resource.data.score == 0 &&
                       request.resource.data.answers.size() == 0;
        allow delete: if false;
      }
    }

    // Collection: performance (Class Performance Overview, rujuk BLUEPRINT.md
    // Seksyen 5.5). subjectLevel (contoh "Add Maths Form 4") ialah document ID
    // untuk parent collection, students ialah sub-collection.
    // - Sesiapa yang login boleh baca (student/parent nanti perlu tengok markah sendiri)
    // - Hanya teacher yang mengajar subjectLevel tu (senarai users/{uid}.subjects)
    //   boleh tulis markah student dalam subjek tu
    match /performance/{subjectLevel}/students/{studentUid} {
      allow read: if request.auth != null;
      allow write: if teachesSubject(subjectLevel);
    }

    // Collection: quizAttempts (Interactive Quiz - Self-Paced, rujuk
    // BLUEPRINT.md Seksyen 9.6). Document ID deterministik
    // "{quizId}_{studentUid}" (satu attempt sahaja per student per quiz,
    // tiada retake) - ditulis terus dari client, tiada get() ke dokumen
    // lain diperlukan dalam rule ni.
    // - Hanya student pemilik attempt tu boleh baca/cipta/kemaskini, ATAU Admin
    //   boleh baca (perlu untuk count() aggregation dalam admin_reports_screen.dart)
    // - `resource == null` di-check dulu (guna short-circuit || - pattern sama
    //   macam attendance rule di atas) sebab attempt_quiz_screen.dart's _load()
    //   MEMANG get() dokumen ni SEBELUM attempt pertama wujud (cek "student ni
    //   dah attempt ke belum") - tanpa ni, get() ke dokumen yang tak wujud lagi
    //   dinafikan sebab `resource.data.studentUid` invalid bila resource null,
    //   throw PERMISSION_DENIED yang attempt_quiz_screen.dart tak catch -
    //   punca bug sebenar "loading non-stop" bila student cuba buka quiz
    //   Self-Paced buat kali pertama.
    // - Teacher yang cipta quiz tu (createdBy) turut boleh baca semua attempt
    //   untuk quiz tu (perlu untuk quiz_results_screen.dart - Teacher tengok
    //   markah semua student) - get() ke quizzes/{quizId} guna quizId yang
    //   disimpan terus pada setiap attempt doc.
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null &&
                   (resource == null ||
                    request.auth.uid == resource.data.studentUid ||
                    isAdmin() ||
                    (exists(/databases/$(database)/documents/quizzes/$(resource.data.quizId)) &&
                     get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.createdBy == request.auth.uid));
      // Tiada write dari client langsung - attempt hanya ditulis oleh Cloud
      // Function submitQuizAttempt (Admin SDK), yang kira markah sendiri
      // dari answerKeys dan semak due date + had retake di server. Dulu
      // student tulis terus (termasuk `score`), jadi markah boleh dipalsukan.
      allow create, update, delete: if false;
    }

    // Collection: warningLetters (rujuk BLUEPRINT.md Seksyen 5.5)
    // - Boleh dibaca oleh teacher yang hantar, student berkaitan, atau parent
    //   student tu (tiga field terus pada dokumen, bukan get() ke rekod lain),
    //   ATAU Admin (perlu untuk count() aggregation dalam admin_reports_screen.dart)
    // - Hanya boleh dicipta oleh teacher (teacherUid mesti padan uid login)
    // - Update dihadkan ke field `acknowledged` sahaja (student/parent tandakan
    //   dah baca) - tiada UI untuk ni lagi, tapi rule sedia untuk bila dibina
    match /warningLetters/{letterId} {
      allow read: if request.auth != null &&
                   (request.auth.uid == resource.data.teacherUid ||
                    request.auth.uid == resource.data.studentUid ||
                    request.auth.uid == resource.data.parentUid ||
                    isAdmin());
      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.teacherUid;
      allow update: if request.auth != null &&
                     (request.auth.uid == resource.data.studentUid ||
                      request.auth.uid == resource.data.parentUid) &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged']);
      allow delete: if false;
    }

    // Collection: announcements (Teacher -> semua Student satu subjek, rujuk
    // BLUEPRINT.md Seksyen 5.19)
    // - Sesiapa yang login boleh baca (sama macam quizzes/performance - bukan
    //   data sensitif, dan elak masalah rules tak dapat "prove" query whereIn)
    // - Hanya Teacher boleh cipta, untuk subjek yang DIA SENDIRI ajar sahaja,
    //   dengan readBy kosong
    // - Update dihadkan ke field `readBy` sahaja, dan hanya untuk TAMBAH uid
    //   sendiri sekali (tak boleh buang orang lain / tambah uid orang lain)
    // - Delete: teacher yang hantar, atau Admin
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if isTeacher() &&
                     request.auth.uid == request.resource.data.teacherUid &&
                     teachesSubject(request.resource.data.subjectLevel) &&
                     request.resource.data.readBy.size() == 0;
      allow update: if request.auth != null &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
                     request.resource.data.readBy.hasAll(resource.data.readBy) &&
                     request.resource.data.readBy.size() == resource.data.readBy.size() + 1 &&
                     request.auth.uid in request.resource.data.readBy &&
                     !(request.auth.uid in resource.data.readBy);
      allow delete: if request.auth != null &&
                     (request.auth.uid == resource.data.teacherUid || isAdmin());
    }

    // Collection: attendance (Attendance Overview, rujuk BLUEPRINT.md Seksyen 5.8)
    // studentUid ialah document ID parent, records ialah sub-collection.
    // - Boleh dibaca oleh student berkaitan, teacher yang mengajar subjek rekod
    //   tu, atau parent student tu (studentUid in users/{uid}.childUids -
    //   array, sebab satu parent boleh ada 2+ anak berdaftar, rujuk
    //   BLUEPRINT.md Seksyen 5.9)
    // - `resource == null` di-check dulu (guna short-circuit ||) sebab teacher
    //   perlu get() rekod yang MUNGKIN belum wujud lagi (cek dah tandakan ke
    //   belum untuk tarikh tu) - tanpa ni, get() ke dokumen yang tak wujud
    //   akan dinafikan sebab `resource.data.subject` invalid bila resource null.
    // - Hanya boleh dicipta/dikemaskini oleh teacher yang mengajar subjek
    //   dalam rekod tu (request.resource.data.subject)
    match /attendance/{studentUid}/records/{recordId} {
      allow read: if request.auth != null &&
                   (resource == null ||
                    request.auth.uid == studentUid ||
                    teachesSubject(resource.data.subject) ||
                    (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     studentUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('childUids', [])));
      allow create, update: if teachesSubject(request.resource.data.subject);
      allow delete: if false;
    }

    // Collection: mfaCodes (email OTP second factor, rujuk BLUEPRINT.md
    // Seksyen 5.17). Hashed code + expiry + attempt count sahaja - client
    // TIDAK PERNAH baca/tulis terus. Hanya DUA Cloud Function
    // (sendMfaCode/verifyMfaCode di functions/index.js) yang sentuh
    // collection ni, guna Admin SDK yang bypass rules sepenuhnya - jadi
    // deny eksplisit ni sekadar dokumentasi (default Firestore pun dah
    // deny access yang tak dibenarkan secara eksplisit), bukan keperluan.
    match /mfaCodes/{uid} {
      allow read, write: if false;
    }

    // Collection: reports (Report Message, rujuk BLUEPRINT.md Seksyen 5.22).
    // ID deterministik {messageId}_{reporterUid} = satu report per orang per
    // mesej - report kali kedua kena doc sedia ada, dikira `update`
    // (Admin sahaja) jadi ditolak, client tunjuk "already reported".
    // - CREATE: participant chat tu sahaja, untuk diri sendiri, status 'open'
    // - READ/UPDATE: Admin sahaja (review di flagged_messages_screen.dart)
    match /reports/{reportId} {
      allow create: if request.auth != null &&
                       request.resource.data.reportedBy == request.auth.uid &&
                       request.resource.data.reportedUid != request.auth.uid &&
                       request.resource.data.status == 'open' &&
                       reportId == request.resource.data.messageId + '_' + request.auth.uid &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
      allow read, update: if isAdmin();
      allow delete: if false;
    }
  }
}
